# Local default: SQLite under ./data/
# DATABASE_URL=sqlite:///./data/registry.db
#
# Production / Vercel: REQUIRED. Use hosted Postgres (Neon, etc.).
# Bare postgres:// or postgresql:// URLs are normalized to postgresql+psycopg2://.
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/agent_registry?sslmode=require
#
# On Vercel, SQLite will not work (read-only FS). Set DATABASE_URL in the
# Vercel project Environment Variables — never commit real credentials.
DATABASE_URL=sqlite:///./data/registry.db

# Optional. If set, mutating routes require header X-Registry-Token.
# Leave unset for an open local demo. Do not expose an unset-token instance publicly.
# On public Vercel deploys, set REGISTRY_TOKEN as well.
REGISTRY_TOKEN=

MAX_REQUEST_BYTES=65536
RATE_LIMIT_PER_MINUTE=120
HOST=127.0.0.1
PORT=8080

# Client: registry URL for the CLI
REGISTRY_URL=http://127.0.0.1:8080
