# SQLite by default. For Postgres use:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/agent_registry
DATABASE_URL=sqlite:///./data/registry.db

# Optional. If set, mutating routes require header X-Registry-Token.
# Leave unset for an open local demo. Do not expose an unset-token instance publicly.
REGISTRY_TOKEN=

MAX_REQUEST_BYTES=65536
RATE_LIMIT_PER_MINUTE=120
HOST=127.0.0.1
PORT=8080

# Client: registry URL for the CLI
REGISTRY_URL=http://127.0.0.1:8080
